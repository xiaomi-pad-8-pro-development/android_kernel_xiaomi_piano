-obj-$(CONFIG_XM_POWER_SUPPLY)	+= mca_common/
-obj-$(CONFIG_XM_POWER_SUPPLY)	+= mca_shared_memory/
-obj-$(CONFIG_XM_POWER_SUPPLY)	+= mca_platform/
