diff --git a/BUILD.bazel b/BUILD.bazel
new file mode 100644
index 0000000..7a90c4d
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,23 @@
+# Xiaomi input drivers for the Pad 8 Pro (piano): the 6.6 sources, built
+# with their own Makefiles against the Qualcomm 6.12 kernel.
+load("//build/kernel/kleaf:kernel.bzl", "kernel_module")
+
+package(default_visibility = ["//visibility:public"])
+
+kernel_module(
+    name = "sun_perf_input",
+    srcs = glob(["**/*.c", "**/*.h", "**/Makefile", "**/Kbuild"]),
+    outs = [
+        "hall/xiaomi_hall.ko",
+        "mi_fp/mi_fp.ko",
+        "nanosic/nanosic_driver.ko",
+        "ntag/fm_ntag_i2c.ko",
+    ],
+    kernel_build = "//soc-repo:sun_perf_base_kernel",
+    deps = [
+        "//soc-repo:all_headers",
+        "//soc-repo:sun_perf/drivers/soc/qcom/panel_event_notifier",
+        "//soc-repo:sun_perf/kernel/trace/qcom_ipc_logging",
+        "//vendor/xiaomi/mca:sun_perf_mca",
+    ],
+)
diff --git a/Kbuild b/Kbuild
new file mode 100644
index 0000000..4ff2eae
--- /dev/null
+++ b/Kbuild
@@ -0,0 +1,15 @@
+# Xiaomi input drivers for the Pad 8 Pro (piano): the keyboard cover
+# (Nanosic 803), its hall sensors, the FM19511 NFC tag and the
+# fingerprint glue, built out of tree against the Qualcomm 6.12 kernel.
+INPUT_ROOT := $(if $(filter /%,$(KBUILD_EXTMOD)),$(KBUILD_EXTMOD),$(abspath $(srctree)/$(KBUILD_EXTMOD)))
+
+export CONFIG_KEYBOARD_NANO_8030 := m
+export CONFIG_INPUT_XIAOMI_HALL := m
+export CONFIG_FM_NTAG_I2C := m
+export CONFIG_MACH_XIAOMI_PIANO := y
+subdir-ccflags-y += -I$(INPUT_ROOT)/include -DCONFIG_MACH_XIAOMI_PIANO=1
+# The soc-repo modules these call are not in the base kernel config, so
+# without these their headers compile in stubs.
+subdir-ccflags-y += -DCONFIG_QCOM_PANEL_EVENT_NOTIFIER_MODULE=1
+
+obj-m += nanosic/ hall/ ntag/ mi_fp/
diff --git a/Makefile b/Makefile
