diff --git a/arch/arm64/kernel/piano_blklog.c b/arch/arm64/kernel/piano_blklog.c
new file mode 100644
index 000000000..8e46697e2
--- /dev/null
+++ b/arch/arm64/kernel/piano_blklog.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bring-up only: copy the kernel log to the start of the rawdump partition
+ * every few seconds and on reboot, so a boot that never reaches adb can be
+ * read back later from recovery without the log being overwritten.
+ *
+ * Layout: 4K header ("PIANOLOG", u32 sequence, u32 length), then the log.
+ */
+
+#include <linux/bio.h>
+#include <linux/blkdev.h>
+#include <linux/init.h>
+#include <linux/kmsg_dump.h>
+#include <linux/mutex.h>
+#include <linux/reboot.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+#include <linux/workqueue.h>
+
+#define BLKLOG_PART	"rawdump"
+#define BLKLOG_SIZE	SZ_1M
+#define BLKLOG_HDR	SZ_4K
+/*
+ * The board can lock up hard about a second into boot, so write every
+ * 100 ms for the first 10 s, then every 10 s, and on reboot.
+ */
+#define BLKLOG_FAST	(HZ / 10)
+#define BLKLOG_FAST_FOR	(10 * HZ)
+#define BLKLOG_PERIOD	(HZ / 10)
+
+static struct file *blklog_file;
+static char *blklog_buf;
+static u32 blklog_seq;
+static DEFINE_MUTEX(blklog_lock);
+static struct delayed_work blklog_work;
+
+static int blklog_match(struct device *dev, const void *name)
+{
+	struct block_device *bdev = dev_to_bdev(dev);
+
+	return bdev->bd_meta_info &&
+	       !strcmp((char *)bdev->bd_meta_info->volname, name);
+}
+
+/* The partition shows up only once the UFS driver has probed. */
+static struct block_device *blklog_bdev(void)
+{
+	struct device *dev;
+	struct file *f;
+
+	if (blklog_file)
+		return file_bdev(blklog_file);
+
+	dev = class_find_device(&block_class, NULL, BLKLOG_PART, blklog_match);
+	if (!dev)
+		return NULL;
+	f = bdev_file_open_by_dev(dev->devt, BLK_OPEN_READ | BLK_OPEN_WRITE,
+				  NULL, NULL);
+	put_device(dev);
+	if (IS_ERR(f)) {
+		pr_err("piano_blklog: cannot open %s: %ld\n", BLKLOG_PART,
+		       PTR_ERR(f));
+		return NULL;
+	}
+	blklog_file = f;
+	pr_info("piano_blklog: logging to %s\n", BLKLOG_PART);
+	return file_bdev(f);
+}
+
+static void blklog_flush(void)
+{
+	struct kmsg_dump_iter iter;
+	struct block_device *bdev;
+	struct bio *bio;
+	size_t len = 0;
+	u32 *hdr = (u32 *)blklog_buf;
+	int i, n, ret;
+
+	mutex_lock(&blklog_lock);
+	bdev = blklog_bdev();
+	if (!bdev)
+		goto out;
+
+	kmsg_dump_rewind(&iter);
+	kmsg_dump_get_buffer(&iter, false, blklog_buf + BLKLOG_HDR,
+			     BLKLOG_SIZE - BLKLOG_HDR, &len);
+	memset(blklog_buf, 0, BLKLOG_HDR);
+	memcpy(blklog_buf, "PIANOLOG", 8);
+	hdr[2] = ++blklog_seq;
+	hdr[3] = len;
+
+	n = DIV_ROUND_UP(BLKLOG_HDR + len, PAGE_SIZE);
+	bio = bio_alloc(bdev, n, REQ_OP_WRITE | REQ_SYNC, GFP_KERNEL);
+	bio->bi_iter.bi_sector = 0;
+	for (i = 0; i < n; i++)
+		__bio_add_page(bio, vmalloc_to_page(blklog_buf + i * PAGE_SIZE),
+			       PAGE_SIZE, 0);
+	ret = submit_bio_wait(bio);
+	bio_put(bio);
+	if (ret)
+		pr_err("piano_blklog: write failed: %d\n", ret);
+out:
+	mutex_unlock(&blklog_lock);
+}
+
+static void blklog_work_fn(struct work_struct *work)
+{
+	blklog_flush();
+	schedule_delayed_work(&blklog_work,
+			      time_before(jiffies, INITIAL_JIFFIES + BLKLOG_FAST_FOR) ?
+			      BLKLOG_FAST : BLKLOG_PERIOD);
+}
+
+/* Reboot notifiers run before device_shutdown(), while UFS still works. */
+static int blklog_reboot(struct notifier_block *nb, unsigned long action,
+			 void *data)
+{
+	blklog_flush();
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block blklog_reboot_nb = {
+	.notifier_call = blklog_reboot,
+};
+
+static int __init blklog_init(void)
+{
+	blklog_buf = vzalloc(BLKLOG_SIZE);
+	if (!blklog_buf)
+		return -ENOMEM;
+	INIT_DELAYED_WORK(&blklog_work, blklog_work_fn);
+	schedule_delayed_work(&blklog_work, 0);
+	register_reboot_notifier(&blklog_reboot_nb);
+	return 0;
+}
+late_initcall(blklog_init);
diff --git a/arch/arm64/kernel/piano_memcon.c b/arch/arm64/kernel/piano_memcon.c
new file mode 100644
index 000000000..d86c7e88d
--- /dev/null
+++ b/arch/arm64/kernel/piano_memcon.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bring-up only: copy the kernel log into the unused ramoops dmesg zone from
+ * right after paging_init(), before ramoops itself is up. Each write is
+ * cleaned to PoC so it survives a warm reset.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/string.h>
+#include <asm/cacheflush.h>
+#include <asm/early_ioremap.h>
+
+/*
+ * Two rings, used in turn on each boot, so a boot that falls back to
+ * recovery does not overwrite the log of the boot that failed. The boot
+ * counter is stored 32 times and read by a per-bit majority vote, because
+ * the memory gets bit flips over a warm reset.
+ */
+#define MEMCON_RING0	0xa3501000
+#define MEMCON_RING1	0xa3541000
+#define MEMCON_COUNT	0xa35c0000
+#define MEMCON_COUNT_COPIES	32
+#define MEMCON_SIZE	0xff000
+#define MEMCON_MAGIC	0x4d454d43	/* "MEMC" */
+/* early_memremap() maps at most 256K per slot. */
+#define MEMCON_EARLY_SIZE	0x3f000
+
+static u8 *memcon;
+static phys_addr_t memcon_base;
+static u32 memcon_size = MEMCON_EARLY_SIZE;
+
+static void memcon_write(struct console *con, const char *s, unsigned int n)
+{
+	/* Bring-up: keep userspace (init) lines and kernel errors only. */
+	if (con && !strnstr(s, "init", n) && !strnstr(s, "rror", n) &&
+	    !strnstr(s, "ail", n) && !strnstr(s, "anic", n))
+		return;
+	u32 *hdr = (u32 *)memcon;
+	u32 pos = hdr[1];
+
+	while (n--) {
+		memcon[16 + pos % (memcon_size - 16)] = *s++;
+		pos++;
+	}
+	hdr[0] = MEMCON_MAGIC;
+	hdr[1] = pos;
+	dcache_clean_poc((unsigned long)memcon,
+			 (unsigned long)memcon + memcon_size);
+}
+
+static struct console memcon_console = {
+	.name	= "memcon",
+	.write	= memcon_write,
+	.flags	= CON_PRINTBUFFER | CON_ANYTIME | CON_ENABLED,
+	.index	= -1,
+};
+
+static u32 __init memcon_next_boot(void)
+{
+	u32 *cnt, boot = 0;
+	int i, bit;
+
+	cnt = early_memremap(MEMCON_COUNT, PAGE_SIZE);
+	if (!cnt)
+		return 0;
+	for (bit = 0; bit < 32; bit++) {
+		int votes = 0;
+
+		for (i = 0; i < MEMCON_COUNT_COPIES; i++)
+			votes += (cnt[i] >> bit) & 1;
+		if (votes * 2 > MEMCON_COUNT_COPIES)
+			boot |= 1U << bit;
+	}
+	boot++;
+	for (i = 0; i < MEMCON_COUNT_COPIES; i++)
+		cnt[i] = boot;
+	dcache_clean_poc((unsigned long)cnt,
+			 (unsigned long)(cnt + MEMCON_COUNT_COPIES));
+	early_memunmap(cnt, PAGE_SIZE);
+	return boot;
+}
+
+/* Right after early_ioremap_init(), through a temporary fixmap mapping. */
+void __init piano_memcon_early_init(void)
+{
+	static const char hello[] = "memcon: early\n";
+	u32 boot = memcon_next_boot();
+
+	memcon_base = (boot & 1) ? MEMCON_RING1 : MEMCON_RING0;
+	memcon = early_memremap(memcon_base, MEMCON_EARLY_SIZE);
+	if (!memcon)
+		return;
+	memset(memcon, 0, 16);
+	((u32 *)memcon)[2] = boot;
+	memcon_write(NULL, hello, sizeof(hello) - 1);
+	register_console(&memcon_console);
+}
+
+/* After paging_init(): move to the linear map, keeping what was written. */
+void __init piano_memcon_init(void)
+{
+	static const char hello[] = "memcon: linear map\n";
+	u8 *early = memcon;
+
+	if (!early)
+		return;
+	console_lock();
+	memcon = phys_to_virt(memcon_base);
+	console_unlock();
+	early_memunmap(early, MEMCON_EARLY_SIZE);
+	memcon_write(NULL, hello, sizeof(hello) - 1);
+}
