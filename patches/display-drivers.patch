+	priv_info->mi_per_timing_fps_len = utils->count_u32_elems(utils->data, "mi,mdss-dsi-supported-fps-list");
+	if (priv_info->mi_per_timing_fps_len <= 0 ) {
+		DSI_ERR("not support dfps-list for the panel, rc = %d\n", rc);
