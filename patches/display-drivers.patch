+			cmd_update_index = DSI_CMD_SET_MI_LOCAL_HBM_NORMAL_WHITE_110NIT_UPDATE;
+			memcpy(&update_D1_reg[0], &panel->mi_cfg.lhbm_rgb_param[6],sizeof(u8)*6);
+			for(i = 1; i < 6; i += 2) {
+				tmp = (((update_D1_reg[i-1]) << 8) | update_D1_reg[i])*4*(lhbm_O9_WHITE_200NIT_ratio_pa[bl_index][j])/1000;
+				update_D1_reg[i-1] = (tmp >> 8) & 0xFF;
+				update_D1_reg[i] = tmp & 0xFF;
+				j += 1;
+			}
+			break;
+		case DSI_CMD_SET_MI_LOCAL_HBM_HLPM_WHITE_1000NIT:
+			cmd_update_index = DSI_CMD_SET_MI_LOCAL_HBM_HLPM_WHITE_1000NIT_UPDATE;
+			memcpy(&update_D1_reg[0], &panel->mi_cfg.lhbm_rgb_param[0],sizeof(u8)*6);
+			for(i = 1; i < 6; i += 2) {
+				tmp = (((update_D1_reg[i-1]) << 8) | update_D1_reg[i])*4*(lhbm_O9_WHITE_1200NIT_ratio_pa[bl_index][j])/1000;
+				update_D1_reg[i-1] = (tmp >> 8) & 0xFF;
+				update_D1_reg[i] = tmp & 0xFF;
+				j += 1;
+			}
+			break;
+		case DSI_CMD_SET_MI_LOCAL_HBM_HLPM_WHITE_110NIT:
+			cmd_update_index = DSI_CMD_SET_MI_LOCAL_HBM_HLPM_WHITE_110NIT_UPDATE;
+			memcpy(&update_D1_reg[0], &panel->mi_cfg.lhbm_rgb_param[6],sizeof(u8)*6);
+			for(i = 1; i < 6; i += 2) {
+				tmp = (((update_D1_reg[i-1]) << 8) | update_D1_reg[i])*4*(lhbm_O9_WHITE_200NIT_ratio_pa[bl_index][j])/1000;
+				update_D1_reg[i-1] = (tmp >> 8) & 0xFF;
