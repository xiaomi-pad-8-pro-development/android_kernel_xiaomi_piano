+			count += snprintf(buf + count, size - count, "0x%02X\n",
+				    dsi_display->panel->dce_pps_cmd[i]);
+		} else {
+			count += snprintf(buf + count, size - count, "0x%02X,",
+			     dsi_display->panel->dce_pps_cmd[i]);
