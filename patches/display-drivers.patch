+		panel->type, bl_lvl, bl_lvl, bl_index, update_D1_reg[0], update_D1_reg[1], update_D1_reg[2], update_D1_reg[3], update_D1_reg[4], update_D1_reg[5]);
+	cur_mode = panel->cur_mode;
