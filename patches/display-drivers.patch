+		panel->mi_cfg.feature_val[DISP_FEATURE_DIMMING] = FEATURE_OFF;
+	} else if (bl_lvl < 411 && panel->mi_cfg.dimming_state != STATE_DIM_BLOCK &&
+		panel->mi_cfg.feature_val[DISP_FEATURE_DIMMING] == FEATURE_OFF)  {
+		dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_DIMMINGON, false);
