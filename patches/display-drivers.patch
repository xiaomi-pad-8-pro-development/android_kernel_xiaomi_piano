+int mi_dsi_panel_set_dbi_by_temp_bl_O8(struct dsi_panel *panel, u32 bl_lvl)
+{
+	int rc = 0;
+	struct mi_dsi_panel_cfg *mi_cfg;
+	enum dsi_cmd_set_type dbi_bwg_type;
+	int temp = 0;
+	int cur_framerate = 0;
+
+	if (!panel) {
+		return -EINVAL;
+	}
+
+	if (mi_get_panel_id_by_dsi_panel(panel) != O8_PANEL_PA &&
+	    mi_get_panel_id_by_dsi_panel(panel) != O8_PANEL_SA) {
+		return 0;
+	}
+
+	mi_cfg = &panel->mi_cfg;
+	temp = mi_cfg->feature_val[DISP_FEATURE_DBI];
+	cur_framerate = panel->cur_mode->timing.refresh_rate;
+
+	dbi_bwg_type = DSI_CMD_SET_MAX;
+	if (bl_lvl == 0) {
+		mi_cfg->dbi_bwg_type = DSI_CMD_SET_MAX;
+		return -EINVAL;
+	}
+	if (mi_get_panel_id_by_dsi_panel(panel) == O8_PANEL_PA) {
+		if (temp == 0) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMPLW30_BL_MODE;
+		}else if (temp == 30) {
+			if (0x38 > bl_lvl && bl_lvl >= 0x0F) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BL0F_MODE;
+			} else if (0x7C > bl_lvl && bl_lvl >= 0x38) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BL38_MODE;
+			} else if (0x105 > bl_lvl && bl_lvl >= 0x7C) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BL7C_MODE;
+			} else if (0x217 > bl_lvl && bl_lvl >= 0x105) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BL105_MODE;
+			} else if (0x328 >= bl_lvl && bl_lvl >= 0x217) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BL217_MODE;
+			} else if (bl_lvl == 0x328) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BLEQ328_MODE;
+			}else if (bl_lvl > 0x328) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP30_BL328_MODE;
+			}
+		} else if (temp == 35) {
+			if (0x38 > bl_lvl && bl_lvl >= 0x0F) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BL0F_MODE;
+			} else if (0x7C > bl_lvl && bl_lvl >= 0x38) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BL38_MODE;
+			} else if (0x105 > bl_lvl && bl_lvl >= 0x7C) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BL7C_MODE;
+			} else if (0x217 > bl_lvl && bl_lvl >= 0x105) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BL105_MODE;
+			} else if (0x328 >= bl_lvl && bl_lvl >= 0x217) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BL217_MODE;
+			} else if (bl_lvl == 0x328) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BLEQ328_MODE;
+			}else if (bl_lvl > 0x328) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP35_BL328_MODE;
+			}
+		} else if (temp == 45) {
+			if (0x38 > bl_lvl && bl_lvl >= 0x0F) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BL0F_MODE;
+			} else if (0x7C > bl_lvl && bl_lvl >= 0x38) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BL38_MODE;
+			} else if (0x105 > bl_lvl && bl_lvl >= 0x7C) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BL7C_MODE;
+			} else if (0x217 > bl_lvl && bl_lvl >= 0x105) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BL105_MODE;
+			} else if (0x328 >= bl_lvl && bl_lvl >= 0x217) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BL217_MODE;
+			} else if (bl_lvl == 0x328) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BLEQ328_MODE;
+			}else if (bl_lvl > 0x328) {
+				dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_TEMP45_BL328_MODE;
+			}
+	    }
+	}
+
+	if (mi_get_panel_id_by_dsi_panel(panel) == O8_PANEL_SA) {
+		if (temp == 0){
+			dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_OFF_MODE;
+		} else if (temp == TEMP_INDEX_30){
+			dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_30_MODE;
+		} else if (temp == TEMP_INDEX_35){
+			dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_35_MODE;
+		} else if (temp == TEMP_INDEX_45){
+			dbi_bwg_type = DSI_CMD_SET_MI_DBI_BWG_45_MODE;
+		}
+	}
+
+	if ((dbi_bwg_type != mi_cfg->dbi_bwg_type) && (dbi_bwg_type != DSI_CMD_SET_MAX)) {
+		rc = dsi_panel_tx_cmd_set(panel, dbi_bwg_type,false);
+		if (rc)
+		{
+			DISP_ERROR("(%s) send  cmds(%s) failed! bl_lvl(%d),rc(%d)\n",
+					panel->name, cmd_set_prop_map[dbi_bwg_type], bl_lvl, rc);
+			return rc;
+		}
+		mi_cfg->dbi_bwg_type = dbi_bwg_type;
+	}
+
+	return rc;
+}
