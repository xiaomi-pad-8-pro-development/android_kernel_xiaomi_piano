+static ssize_t panel_type_show(struct device *device,
+			struct device_attribute *attr, char *buf)
+{
+	struct dsi_display *display = NULL;
+	struct disp_display *dd_ptr = to_disp_display(device);
+	display = (struct dsi_display *)dd_ptr->display;
+
+	if (dd_ptr->intf_type == MI_INTF_DSI) {
+		return snprintf(buf, PAGE_SIZE, "%d\n", display->panel->mi_cfg.panel_type);
+	} else {
+		return snprintf(buf, PAGE_SIZE, "Unsupported display(%s intf)\n",
+			get_disp_intf_type_name(dd_ptr->intf_type));
+	}
+}
+
+static ssize_t ktz8866_reg_rw_store(struct device *device,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct disp_display *dd_ptr = to_disp_display(device);
+	int ret = 0;
+
+	if (dd_ptr->intf_type == MI_INTF_DSI) {
+		struct ktz8866_config ktz_config;
+		sscanf(buf, "%d %d %x %x", &ktz_config.mode, &ktz_config.ktz8866_id, &ktz_config.reg, &ktz_config.value);
+		mi_ktz8866_set_mode(&ktz_config);
+	} else {
+		DISP_ERROR("Unsupported display(%s intf)\n",
+			get_disp_intf_type_name(dd_ptr->intf_type));
+		ret = -EINVAL;
+	}
+
+	return ret ? ret : count;
+}
