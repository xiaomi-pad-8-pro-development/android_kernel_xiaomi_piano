+void unregister_mi_dflt_lat_update_cb(void)
+{
+	dflt_lat_update_cb = NULL;
+	dflt_lat_vote_timer = NULL;
+	dflt_lat_cal_cb = NULL;
+}
+EXPORT_SYMBOL_GPL(unregister_mi_dflt_lat_update_cb);
