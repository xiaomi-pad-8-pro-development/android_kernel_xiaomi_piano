+	fsm_mutex_lock();
+	if (volume < 0 || volume > FSM_VOLUME_MAX) {
+		// pr_warning("invalid volume: %d, default 0dB", volume);
+		volume = FSM_VOLUME_MAX;
+	}
+	cfg->volume = volume;
+	if (!cfg->stream_muted) {
+		fsm_list_func(fsm_dev, fsm_config_vol);
+	}
+	fsm_mutex_unlock();
+}
