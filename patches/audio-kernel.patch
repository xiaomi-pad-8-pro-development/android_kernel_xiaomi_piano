+		return;
+
+	fsm_mutex_lock();
+	if (volume < 0 || volume > FSM_VOLUME_MAX) {
+		pr_debug("invalid volume: %d, default 0dB", volume);
+		volume = FSM_VOLUME_MAX;
+	}
+
+	cfg->ramp_vol = volume;
+	if (cfg->stream_muted)
+		goto exit_unlock;
+
+	fsm_dev = fsm_get_fsm_dev_by_position(FSM_POS_RCV);
+	if (fsm_dev == NULL) {
+		pr_err("Failed to set ramp volume, NO RCV/Left PA");
+		goto exit_unlock;
