+void fsm_init(void)
+{
+	int ret;
+
+	ret = fsm_hal_open();
+	if (ret) {
+		pr_err("hal open fail:%d", ret);
+		return;
+	}
+	fsm_mutex_lock();
+	pr_info("version: %s", FSM_CODE_VERSION);
+	pr_info("branch : %s", FSM_GIT_BRANCH);
+	pr_info("date   : %s", FSM_CODE_DATE);
+	ret = fsm_try_init();
+	if (ret) { // no device or firmware
+		pr_err("init failed: %d", ret);
+	}
+	pr_debug("done");
+	fsm_mutex_unlock();
+}
+
+void fsm_speaker_onn(void)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev = NULL;
+	int ret;
+
+	if (cfg->speaker_on && (cfg->next_scene == cfg->cur_scene)) {
+		pr_debug("no need repeat to speaker on");
+		return;
+	}
+	pr_info("scene: %04X", cfg->next_scene);
+	if(cfg->speaker_on)
+		return;
+	fsm_mutex_lock();
+	cfg->stream_muted = false;
+	ret = fsm_try_init();
+	if (ret) { // no device or firmware
+		pr_err("init failed: %d", ret);
+		fsm_mutex_unlock();
+		return;
+	}
+	fsm_list_func(fsm_dev, fsm_stub_switch_preset);
+	fsm_list_func(fsm_dev, fsm_stub_start_up);
+	cfg->cur_angle = cfg->next_angle;
+	cfg->cur_scene = cfg->next_scene;
+	cfg->speaker_on = true;
+	pr_debug("done");
+	fsm_mutex_unlock();
+	fsm_set_calib_mode();
+}
+
+void fsm_speaker_off(void)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev = NULL;
+	int ret;
+
+	if (!cfg->speaker_on) {
+		pr_debug("no need repeat to speaker off");
+		return;
+	}
+
+	pr_info("scene: %04X", cfg->next_scene);
+	if (!cfg->speaker_on)
+		return;
+	fsm_mutex_lock();
+	cfg->stream_muted = true;
+	ret = fsm_try_init();
+	if (ret) {
+		pr_err("try init failed: %d", ret);
+		fsm_mutex_unlock();
+		return;
+	}
+	fsm_list_func(fsm_dev, fsm_stub_shut_down);
+	cfg->speaker_on = false;
+	cfg->force_calib = false;
+	cfg->next_scene = BIT(0);
+	pr_debug("done");
+	fsm_mutex_unlock();
+}
+
+void fsm_set_calib_mode(void)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev = NULL;
+	int retry = 0;
+
+	if (!cfg->force_calib) {
+		return;
+	}
+	while (!cfg->speaker_on && retry < 50) {
+		fsm_delay_ms(10);
+		retry++;
+	}
+	fsm_mutex_lock();
+	fsm_list_func(fsm_dev, fsm_stub_pre_calib);
+	cfg->next_scene = FSM_SCENE_MUSIC;
+	fsm_mutex_unlock();
+}
+
+void fsm_stereo_rotation(int next_angle)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev = NULL;
+
+	if (next_angle >= 360) { // angle range: [0 ~ 359]
+		next_angle %= 360;
+	}
+	if (cfg->cur_angle == next_angle) {
+		return;
+	}
+	fsm_mutex_lock();
+	pr_info("scene:%04X, angle:%d", cfg->next_scene, next_angle);
+	cfg->next_angle = next_angle;
+	if (cfg->stream_muted || !(cfg->next_scene & FSM_SCENE_MUSIC)) {
+		fsm_mutex_unlock();
+		return;
+	}
+	fsm_list_func_arg(fsm_dev, fsm_swap_channel, cfg->next_angle);
+	cfg->cur_angle = cfg->next_angle;
+	fsm_mutex_unlock();
+}
+
+void fsm_dump(void)
+{
+	fsm_dev_t *fsm_dev = NULL;
+	fsm_mutex_lock();
+	fsm_list_func(fsm_dev, fsm_reg_dump);
+	fsm_mutex_unlock();
+}
+
+void fsm_deinit(void)
+{
+	fsm_dev_t *fsm_dev = NULL;
+
+	fsm_mutex_lock();
+	if (fsm_dev_count() <= 0) {
+		fsm_mutex_unlock();
+		return;
+	}
+	fsm_list_func(fsm_dev, fsm_stub_dev_deinit);
+	fsm_firmware_deinit();
+	fsm_mutex_unlock();
+	fsm_hal_close();
+}
diff --git a/asoc/codecs/fs19xx/fsm_firmware.c b/asoc/codecs/fs19xx/fsm_firmware.c
new file mode 100644
index 0000000..8de3ce6
--- /dev/null
+++ b/asoc/codecs/fs19xx/fsm_firmware.c
@@ -0,0 +1,140 @@
+/**
+ * Copyright (C) Fourier Semiconductor Inc. 2016-2020. All rights reserved.
+ * 2019-02-22 File created.
+ */
+
+#include "fsm_public.h"
+#if defined(CONFIG_FSM_FIRMWARE)
+#include <linux/firmware.h>
+#include <linux/slab.h>
+
+static int g_fsm_fw_init = 0;
+
+#ifndef FW_ACTION_HOTPLUG
+#define FW_ACTION_HOTPLUG 1
+#endif
+
+#ifdef FSM_UNUSED_CODE
+static void *fsm_devm_kzalloc(struct device *dev, void *buf, size_t size)
+{
+	char *devm_buf = devm_kzalloc(dev, size, GFP_KERNEL);
+
+	if (!devm_buf) {
+		return devm_buf;
+	} else {
+		memcpy(devm_buf, buf, size);
+	}
+
+	return devm_buf;
+}
+
+static void fsm_devm_kfree(struct device *dev, void **buf)
+{
+	if (*buf) {
+		devm_kfree(dev, *buf);
+		*buf = NULL;
+	}
+}
+#endif
+
+static void fsm_firmware_inited(const struct firmware *cont, void *context)
+{
+	struct device *dev = (struct device *)context;
+	int ret;
+
+	if (dev == NULL || cont == NULL) {
+		pr_err("bad parameter");
+		return;
+	}
+
+	pr_info("size: %zu", cont->size);
+	fsm_mutex_lock();
+	ret = fsm_parse_preset(cont->data, (uint32_t)cont->size);
+	fsm_mutex_unlock();
+	release_firmware(cont);
+	if (ret) {
+		pr_err("parse firmware fail: %d", ret);
+		g_fsm_fw_init = 0;
+	}
+}
+
+int fsm_firmware_init(char *fw_name)
+{
+	struct device *dev;
+	int ret;
+
+	if (fw_name == NULL) {
+		pr_err("invalid firmware name");
+		return -EINVAL;
+	}
+	if (fsm_get_presets() || g_fsm_fw_init) {
+		return MODULE_INITED;
+	}
+	dev = fsm_get_pdev();
+	if (dev == NULL) {
+		pr_err("invalid device");
+		return -EINVAL;
+	}
+
+	pr_info("loading %s in nowait mode", fw_name);
+	ret = request_firmware_nowait(THIS_MODULE, FW_ACTION_HOTPLUG,
+			fw_name, dev, GFP_KERNEL,
+			dev, fsm_firmware_inited);
+	if (ret) {
+		pr_err("request %s failed: %d\n", fw_name, ret);
+		return ret;
+	}
+	g_fsm_fw_init = 1;
+
+	return ret;
+}
+
+int fsm_firmware_init_sync(char *fw_name)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	const struct firmware *fw_cont;
+	struct device *dev;
+	int ret;
+
+	if (fw_name == NULL) {
+		pr_err("invalid firmware name");
+		return -EINVAL;
+	}
+	if (cfg->force_fw) {
+		pr_info("force loading");
+		cfg->force_fw = false;
+		fsm_set_presets(NULL);
+	}
+	if (fsm_get_presets()) {
+		return MODULE_INITED;
+	}
+	dev = fsm_get_pdev();
+	if (dev == NULL) {
+		pr_err("invalid device");
+		return -EINVAL;
+	}
+
+	g_fsm_fw_init = 0;
+	pr_info("loading %s in sync mode", fw_name);
+	ret = request_firmware(&fw_cont, fw_name, dev);
+	if (ret) {
+		pr_err("request %s failed: %d\n", fw_name, ret);
+		return ret;
+	}
+	ret = fsm_parse_preset(fw_cont->data, (uint32_t)fw_cont->size);
+	release_firmware(fw_cont);
+	if (ret) {
+		pr_err("parse firmware fail: %d", ret);
+		return ret;
+	}
+	g_fsm_fw_init = 1;
+
+	return ret;
+}
+
+void fsm_firmware_deinit(void)
+{
+	fsm_set_presets(NULL);
+	g_fsm_fw_init = 0;
+}
+#endif
diff --git a/asoc/codecs/fs19xx/fsm_i2c.c b/asoc/codecs/fs19xx/fsm_i2c.c
new file mode 100644
index 0000000..b440dc9
--- /dev/null
+++ b/asoc/codecs/fs19xx/fsm_i2c.c
@@ -0,0 +1,663 @@
+/*
+ * Copyright (C) Fourier Semiconductor Inc. 2016-2020. All rights reserved.
+ */
