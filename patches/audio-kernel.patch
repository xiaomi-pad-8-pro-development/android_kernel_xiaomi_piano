+void fsm_set_scene(int scene)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev = NULL;
+	bool stream_on;
+
+	if (!cfg || scene < 0 || scene > FSM_SCENE_MAX) {
+		pr_err("invaild scene:%d", scene);
+		return;
+	}
+
+	stream_on = !cfg->stream_muted;
+	if (stream_on) {
+		fsm_speaker_off();
+		fsm_delay_ms(20);
+	}
+
+	fsm_mutex_lock();
+	if (scene == 16) {
+		pr_info("Note: calib scene id: %d", scene);
+		cfg->force_calib = 1;
+		scene = 0; // music scene for calibration
+	} else {
+		cfg->force_calib = 0; // exit calibration
+	}
+	if (cfg->next_scene != BIT(scene) && cfg->speaker_on) {
+		fsm_list_func(fsm_dev, fsm_stub_shut_down);
+		fsm_delay_ms(20);
+	}
+	cfg->next_scene = BIT(scene);
+	if ((cfg->next_scene == FSM_SCENE_MUSIC) && cfg->ultrasound_on && !cfg->force_calib) {
+		cfg->next_scene = FSM_SCENE_VOIP_ULTRA;
+	}
+
+	fsm_list_func(fsm_dev, fsm_stub_switch_preset);
+	fsm_mutex_unlock();
+
+	if (stream_on)
+		fsm_speaker_onn();
+
+	if (cfg->speaker_on) {
+		fsm_set_calib_mode();
+	}
+}
