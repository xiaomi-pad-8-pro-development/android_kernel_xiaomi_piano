+int fsm_get_bf(fsm_dev_t *fsm_dev, const uint16_t bf, uint16_t *pval)
+{
+	reg_unit_t reg;
+	uint16_t msk;
+	int ret;
+
+	if (fsm_dev == NULL) {
+		return -EINVAL;
+	}
+	reg.len = (bf >> 12) & 0x0F;
+	reg.pos = (bf >> 8) & 0x0F;
+	reg.addr = bf & 0xFF;
+	ret = fsm_reg_multiread(fsm_dev, reg.addr, &reg.value);
+	if (ret) {
+		pr_err("get bf:%04X failed", bf);
+		return ret;
+	}
+	msk = ((1 << (reg.len + 1)) - 1) << reg.pos;
+	reg.value &= msk;
+	if(pval) {
+		*pval = reg.value >> reg.pos;
+	}
+
+	return ret;
+}
