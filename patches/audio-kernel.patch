+static int fsm_afe_rx_port_get(struct snd_kcontrol *kcontrol,
+		struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = fsm_rx_port;
+	pr_debug("get rx port:%d", fsm_rx_port);
+
+	return 0;
+}
