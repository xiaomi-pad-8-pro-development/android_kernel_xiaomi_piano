+	if ((rx_port < 0) || (rx_port > AFE_PORT_ID_INVALID)) {
+		pr_err("out of range (%d)", rx_port);
+		return 0;
+	}
+
+	pr_debug("change from %d to %d", fsm_rx_port, rx_port);
+	fsm_rx_port = rx_port;
+
+	return 0;
+}
