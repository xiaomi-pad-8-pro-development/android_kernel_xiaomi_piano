+static remove_ret_type fsm_codec_remove(struct snd_soc_codec *codec)
+{
+	fsm_dev_t *fsm_dev;
+
+	if (codec == NULL) {
+		return remove_ret_val;
+	}
+	fsm_dev = snd_soc_codec_get_drvdata(codec);
+	if (fsm_dev == NULL) {
+		return remove_ret_val;
+	}
+	if (fsm_dev->id == 0) {
+		fsm_firmware_deinit();
+	}
+	return remove_ret_val;
