+static int fsm_spksw_gpio_get(struct snd_kcontrol *kcontrol,
+			struct snd_ctl_elem_value *ucontrol)
+{
+	fsm_config_t *cfg = fsm_get_config();
+
+	int current_level = gpio_get_value_cansleep(cfg->spksw_gpio);
+	pr_info("spksw level cached = %d, actual = %d\n", cfg->spksw_level, current_level);
+
+	if (current_level < 0) {
+		// failed to read the actual value, fallback to cached value
+		ucontrol->value.enumerated.item[0] = cfg->spksw_level;
+	} else {
+		ucontrol->value.enumerated.item[0] = current_level;
+		cfg->spksw_level = current_level;
+	}
+
+	return 0;
+}
+
+static int fsm_spksw_gpio_put(struct snd_kcontrol *kcontrol,
+			struct snd_ctl_elem_value *ucontrol)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	int spksw_level = ucontrol->value.enumerated.item[0];
+
+	pr_err("spksw = %d\n", spksw_level);
+
+#ifdef CONFIG_TARGET_PRODUCT_ULTRASOUND
+	if (cfg->ultrasound_on) {
+		pr_err("fsm_spksw_gpio_put : ultrasound is on 1! \n");
+		fsm_set_volume(0);
+		fsm_delay_ms(50);
+		pr_err("fsm_spksw_gpio_put : after set volume 0\n");
+	}
+#endif
+	gpio_set_value_cansleep(cfg->spksw_gpio, !!spksw_level);
+
+#ifdef CONFIG_TARGET_PRODUCT_ULTRASOUND
+	if ((cfg->ultrasound_on) && (cfg->volume == 0)) {
+		pr_err("fsm_spksw_gpio_put : ultrasound is on 2! \n");
+		fsm_delay_ms(50);
+		fsm_set_volume(255);
+		pr_err("fsm_spksw_gpio_put : after set volume 255\n");
+	}
+#endif
+
+	return 0;
+}
