+static int fsm_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+
+	if (stream != SNDRV_PCM_STREAM_PLAYBACK) {
+		pr_info("captrue stream");
+		return 0;
+	}
+
+	if (mute) {
+		fsm_speaker_off();
+	} else {
+		fsm_speaker_onn();
+		fsm_afe_mod_ctrl(true);
+	}
+
+	return 0;
+}
