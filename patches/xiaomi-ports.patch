+	&dev_attr_dump_health_desc.attr, &dev_attr_dump_string_desc_serial.attr,
+	&dev_attr_dump_device_desc.attr, &dev_attr_show_hba.attr,
+	&dev_attr_hr.attr, &dev_attr_err_state.attr, &dev_attr_err_reason.attr,
+	NULL,
