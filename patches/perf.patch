+static int subsystem_sleep_stats_sysfs_print(char *buf)
+{
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(subsystems); i++)
+		if (subsystems[i].pid != -2)
+			n += smem_stat_show(subsystems[i].name, buf + n);
+	return n;
+}
