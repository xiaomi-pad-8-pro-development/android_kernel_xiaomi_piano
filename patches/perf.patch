+	&dev_attr_adsp_island.attr, &dev_attr_cdsp.attr, &dev_attr_slpi.attr,
+	&dev_attr_slpi_island.attr, &dev_attr_aosd.attr, &dev_attr_cxsd.attr,
+	&dev_attr_ddr.attr, NULL,
