+static struct genl_family minet_nl_family __ro_after_init = {
+	.name       = MINET_GENERIC_NAME,
+	.version    = MINET_GENERIC_VERSION,
+	.maxattr    = MINET_ATTR_MAX,
+	.policy     = minet_genl_policy,
