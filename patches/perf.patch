+{
+	struct pm_wakeup_device *it;
+	size_t n = 0;
+
+	spin_lock(&wakeup_lock);
+	list_for_each_entry(it, &wakeup_devices, node)
+		if (it->name)
+			n += sprintf(buf + n, "%s ", it->name);
+	spin_unlock(&wakeup_lock);
+	buf[n] = '\n';
+	buf[n + 1] = '\0';
+	return n + 1;
+}
