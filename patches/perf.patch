+static unsigned int miscore_input_hook4(void *priv, struct sk_buff *skb,
+					const struct nf_hook_state *state)
+{
+	struct iphdr *iph = ip_hdr(skb);
+	struct sock *sk = skb_to_full_sk(skb);
+	bool ref = false;
+	int i, ifindex;
+
+	if (!READ_ONCE(miscore_enable))
+		return NF_ACCEPT;
+	if (!iph)
+		return NF_ACCEPT;
+	if (iph->protocol == IPPROTO_UDP) {
+		if (sk) {
+			MISCORE_DBG("udp_sk:raddr=%pI4,laddr=%pI4,proto=%u,id=%d,len=%d,state=%d\n",
+				    &iph->daddr, &iph->saddr, iph->protocol, ntohs(iph->id),
+				    skb->len, sk->sk_state);
+		} else {
+			MISCORE_DBG("udp_no_sk:raddr=%pI4,laddr=%pI4,proto=%u,id=%d,len=%d\n",
+				    &iph->daddr, &iph->saddr, iph->protocol, ntohs(iph->id),
+				    skb->len);
+			sk = udp_get_sock(skb);
+			ref = sk != NULL;
+		}
+	} else if (iph->protocol != IPPROTO_TCP) {
+		return NF_ACCEPT;
+	}
+	if (!sk)
+		return NF_ACCEPT;
+	if (iph->protocol == IPPROTO_TCP && !sk_fullsock(sk))
+		return NF_ACCEPT;
+	spin_lock_bh(&miscore_link_lock);
+	if (skb->dev) {
+		ifindex = skb->dev->ifindex;
+		for (i = 0; i < MISCORE_MAX_LINK; i++) {
+			if (ifindex == miscore_link_info[i].network_para.if_index) {
+				update_downlink_link_stat_v4(&miscore_link_info[i], sk, skb);
+				break;
+			}
+		}
+	} else {
+		MISCORE_DBG("skb->dev is NULL\n");
+	}
+	spin_unlock_bh(&miscore_link_lock);
+	if (ref)
+		sock_put(sk);
+	return NF_ACCEPT;
+}
+
+static unsigned int miscore_postrouting_hook4(void *priv, struct sk_buff *skb,
+					      const struct nf_hook_state *state)
+{
+	struct iphdr *iph = ip_hdr(skb);
+	struct sock *sk = skb_to_full_sk(skb);
+	int i, ifindex;
+
+	if (!READ_ONCE(miscore_enable))
+		return NF_ACCEPT;
+	if (!iph || !sk || !sk_fullsock(sk))
+		return NF_ACCEPT;
+	spin_lock_bh(&miscore_link_lock);
+	if (skb->dev) {
+		ifindex = skb->dev->ifindex;
+		for (i = 0; i < MISCORE_MAX_LINK; i++) {
+			if (ifindex == miscore_link_info[i].network_para.if_index) {
+				update_uplink_link_stat_v4(&miscore_link_info[i], sk, skb);
+				break;
+			}
+		}
+	} else {
+		MISCORE_DBG("skb->dev is NULL\n");
+	}
+	spin_unlock_bh(&miscore_link_lock);
+	return NF_ACCEPT;
+}
+
+static unsigned int miscore_input_hook6(void *priv, struct sk_buff *skb,
+					const struct nf_hook_state *state)
+{
+	struct ipv6hdr *ip6h = ipv6_hdr(skb);
+	struct sock *sk = skb_to_full_sk(skb);
+	bool ref = false;
+	int i, ifindex;
+
+	if (!READ_ONCE(miscore_enable))
+		return NF_ACCEPT;
+	if (!ip6h)
+		return NF_ACCEPT;
+	if (ip6h->nexthdr == IPPROTO_UDP) {
+		if (sk) {
+			MISCORE_DBG("udp6_sk:raddr=%pI6c,laddr=%pI6c,proto=%u,len=%d,state=%d\n",
+				    &ip6h->daddr, &ip6h->saddr, ip6h->nexthdr, skb->len,
+				    sk->sk_state);
+		} else {
+			MISCORE_DBG("udp6_no_sk:raddr=%pI6c,laddr=%pI6c,proto=%u,len=%d\n",
+				    &ip6h->daddr, &ip6h->saddr, ip6h->nexthdr, skb->len);
+			sk = udp6_get_sock(skb);
+			ref = sk != NULL;
+		}
+	} else if (ip6h->nexthdr != IPPROTO_TCP) {
+		return NF_ACCEPT;
+	}
+	if (!sk)
+		return NF_ACCEPT;
+	if (ip6h->nexthdr == IPPROTO_TCP && !sk_fullsock(sk))
+		return NF_ACCEPT;
+	spin_lock_bh(&miscore_link_lock);
+	if (skb->dev) {
+		ifindex = skb->dev->ifindex;
+		for (i = 0; i < MISCORE_MAX_LINK; i++) {
+			if (ifindex == miscore_link_info[i].network_para.if_index) {
+				update_downlink_link_stat_v6(&miscore_link_info[i], sk, skb);
+				break;
+			}
+		}
+	} else {
+		MISCORE_DBG("skb->dev is NULL\n");
+	}
+	spin_unlock_bh(&miscore_link_lock);
+	if (ref)
+		sock_put(sk);
+	return NF_ACCEPT;
+}
+
+static unsigned int miscore_postrouting_hook6(void *priv, struct sk_buff *skb,
+					      const struct nf_hook_state *state)
+{
+	struct ipv6hdr *ip6h = ipv6_hdr(skb);
+	struct sock *sk = skb_to_full_sk(skb);
+	int i, ifindex;
+
+	if (!READ_ONCE(miscore_enable))
+		return NF_ACCEPT;
+	if (!ip6h || !sk || !sk_fullsock(sk))
+		return NF_ACCEPT;
+	spin_lock_bh(&miscore_link_lock);
+	if (skb->dev) {
+		ifindex = skb->dev->ifindex;
+		for (i = 0; i < MISCORE_MAX_LINK; i++) {
+			if (ifindex == miscore_link_info[i].network_para.if_index) {
+				update_uplink_link_stat_v6(&miscore_link_info[i], sk, skb);
+				break;
+			}
+		}
+	} else {
+		MISCORE_DBG("skb->dev is NULL\n");
+	}
+	spin_unlock_bh(&miscore_link_lock);
+	return NF_ACCEPT;
+}
+
+static struct nf_hook_ops miscore_hooks[] = {
+	{
+		.hook = miscore_input_hook4,
+		.pf = NFPROTO_IPV4,
+		.hooknum = NF_INET_LOCAL_IN,
+		.priority = 1,
+	},
+	{
+		.hook = miscore_postrouting_hook4,
+		.pf = NFPROTO_IPV4,
+		.hooknum = NF_INET_POST_ROUTING,
+		.priority = -1,
+	},
+	{
+		.hook = miscore_input_hook6,
+		.pf = NFPROTO_IPV6,
+		.hooknum = NF_INET_LOCAL_IN,
+		.priority = 1,
+	},
+	{
+		.hook = miscore_postrouting_hook6,
+		.pf = NFPROTO_IPV6,
+		.hooknum = NF_INET_POST_ROUTING,
+		.priority = -1,
+	},
+};
+
+static int proc_miscore_enable(const struct ctl_table *table, int write, void *buffer,
+			       size_t *lenp, loff_t *ppos)
+{
+	int ret = proc_dointvec(table, write, buffer, lenp, ppos);
+
+	if (!ret && READ_ONCE(miscore_enable) && READ_ONCE(miscore_period) > 0)
+		mod_timer(&miscore_timer, jiffies + msecs_to_jiffies(READ_ONCE(miscore_period)));
+	return ret;
+}
+
+static struct ctl_table miscore_sysctl_table[] = {
+	{
+		.procname = "miscore_enable",
+		.data = &miscore_enable,
+		.maxlen = sizeof(int),
+		.mode = 0600,
+		.proc_handler = proc_miscore_enable,
+	},
+	{
+		.procname = "miscore_debug",
+		.data = &miscore_debug,
+		.maxlen = sizeof(int),
+		.mode = 0600,
+		.proc_handler = proc_dointvec,
+	},
+	{ }
+};
+
+static int register_miscore_sysctl(void)
+{
+	if (!miscore_sysctl_hdr) {
+		miscore_sysctl_hdr = register_net_sysctl(&init_net, "net/miscore", miscore_sysctl_table);
+		if (!miscore_sysctl_hdr) {
+			printk(KERN_INFO "miscore:register_miscore_sysctl fail!\n");
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int __init miscore_init(void)
+{
+	int ret;
+
+	spin_lock_init(&miscore_app_lock);
+	spin_lock_init(&miscore_link_lock);
+	ret = nf_register_net_hooks(&init_net, miscore_hooks, ARRAY_SIZE(miscore_hooks));
+	if (ret) {
+		printk(KERN_INFO "miscore:%s register miscore_hooks err:%d\n", __func__, ret);
+		return ret;
+	}
+	printk(KERN_INFO "miscore:nf_register_net_hooks success\n");
+	ret = miscore_nl_init();
+	if (ret) {
+		printk(KERN_INFO "miscore:%s register miscore_nl_family err:%d\n", __func__, ret);
+		nf_unregister_net_hooks(&init_net, miscore_hooks, ARRAY_SIZE(miscore_hooks));
+		return ret;
+	}
+	printk(KERN_INFO "miscore:miscore_nl_init success\n");
+	ret = register_miscore_sysctl();
+	if (ret) {
+		printk(KERN_INFO "miscore:%s register miscore_sysctl err:%d\n", __func__, ret);
+		nf_unregister_net_hooks(&init_net, miscore_hooks, ARRAY_SIZE(miscore_hooks));
+		miscore_nl_exit();
+		return ret;
+	}
+	timer_setup(&miscore_timer, miscore_timer_func, 0);
+	printk(KERN_INFO "miscore:miscore_init success\n");
+	return 0;
+}
+
+static void __exit miscore_exit(void)
+{
+	miscore_enable = 0;
+	nf_unregister_net_hooks(&init_net, miscore_hooks, ARRAY_SIZE(miscore_hooks));
+	timer_delete_sync(&miscore_timer);
+	miscore_nl_exit();
+	if (miscore_sysctl_hdr)
+		unregister_net_sysctl_table(miscore_sysctl_hdr);
+}
+
+module_init(miscore_init);
+module_exit(miscore_exit);
+MODULE_LICENSE("GPL v2");
+MODULE_AUTHOR("Wei Liu <liuwei91@xiaomi.com>");
+MODULE_DESCRIPTION("module for xiaomi net score");
diff --git a/miscore/miscore_nl.c b/miscore/miscore_nl.c
new file mode 100644
index 0000000..f2b1d3f
--- /dev/null
+++ b/miscore/miscore_nl.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+/* miscore: generic netlink part (family nl_miscore) */
+#include <linux/module.h>
+#include <linux/skbuff.h>
+#include <net/net_namespace.h>
+#include <net/netlink.h>
+#include <net/genetlink.h>
+
+#include "miscore.h"
+
+static int s_portid;
+
+static struct genl_family miscore_nl_family;
+
+int miscore_nl_send_msg(void *data, int len, u8 cmd, u8 attr)
+{
+	struct sk_buff *skb;
+	void *hdr;
+	int ret, portid;
+
+	if (!READ_ONCE(s_portid)) {
+		MISCORE_DBG("portid is 0\n");
+		return -EINVAL;
+	}
+	skb = nlmsg_new(genlmsg_total_size(nla_total_size(len)), GFP_ATOMIC);
+	if (!skb)
+		return -ENOMEM;
+	hdr = genlmsg_put(skb, READ_ONCE(s_portid), 0, &miscore_nl_family, 0, cmd);
+	if (!hdr) {
+		nlmsg_free(skb);
+		return -EMSGSIZE;
+	}
+	if (nla_put(skb, attr, len, data)) {
+		genlmsg_cancel(skb, hdr);
+		nlmsg_free(skb);
+		return -EMSGSIZE;
+	}
+	genlmsg_end(skb, hdr);
+	portid = READ_ONCE(s_portid);
+	ret = netlink_unicast(init_net.genl_sock, skb, portid, MSG_DONTWAIT);
+	return ret > 0 ? 0 : ret;
+}
+
+static int miscore_nl_cmd_msg_handle(struct sk_buff *skb, struct genl_info *info)
+{
+	struct nlmsghdr *nlh = (struct nlmsghdr *)skb->data;
+	struct genlmsghdr *genlhdr;
+	struct nlattr *nla;
+
+	if (nlh->nlmsg_type != miscore_nl_family.id) {
+		printk(KERN_INFO "miscore:nlmsg_type error\xef\xbc\x9auser_id=%d, kernel_id=%d\n",
+		       nlh->nlmsg_type, miscore_nl_family.id);
+		return -EINVAL;
+	}
+	if (READ_ONCE(s_portid) != nlh->nlmsg_pid) {
+		printk(KERN_INFO "miscore:update portid:new=%d,old=%d\n", nlh->nlmsg_pid,
+		       READ_ONCE(s_portid));
+		s_portid = nlh->nlmsg_pid;
+	}
+	genlhdr = nlmsg_data(nlh);
+	if (genlhdr->cmd != MISCORE_NL_CMD) {
+		printk(KERN_INFO "miscore:unknown cmd:%d\n", genlhdr->cmd);
+		return -EINVAL;
+	}
+	nla = (struct nlattr *)(genlhdr + 1);
+	switch (nla->nla_type) {
+	case MISCORE_NL_ATTR_ENABLE:
+		miscore_handle_score_enable(nla);
+		break;
+	case MISCORE_NL_ATTR_APP:
+		miscore_handle_foreground_app(nla);
+		break;
+	case MISCORE_NL_ATTR_LINK:
+		miscore_handle_link_change(nla);
+		break;
+	case MISCORE_NL_ATTR_PERIOD:
+		miscore_handle_period_change(nla);
+		break;
+	default:
+		MISCORE_DBG("unknown attr:%d\n", nla->nla_type);
+		break;
+	}
+	return 0;
+}
+
+static struct genl_ops miscore_nl_ops[] = {
+	{
+		.cmd = MISCORE_NL_CMD,
+		.validate = GENL_DONT_VALIDATE_STRICT | GENL_DONT_VALIDATE_DUMP,
+		.doit = miscore_nl_cmd_msg_handle,
+		.flags = GENL_ADMIN_PERM,
+	},
+};
+
+static struct genl_family miscore_nl_family __ro_after_init = {
+	.name = "nl_miscore",
+	.version = 1,
+	.maxattr = 5,
+	.module = THIS_MODULE,
+	.ops = miscore_nl_ops,
+	.n_ops = ARRAY_SIZE(miscore_nl_ops),
+	.resv_start_op = 3,
+};
+
+int miscore_nl_init(void)
+{
+	int ret = genl_register_family(&miscore_nl_family);
+
+	if (ret) {
+		printk(KERN_INFO "miscore:register miscore_nl_family fail, ret=%d\n", ret);
+		return ret;
+	}
+	printk(KERN_INFO "miscore:register miscore_nl_family success, familyid=%d\n",
+	       miscore_nl_family.id);
+	return 0;
+}
+
+void miscore_nl_exit(void)
+{
+	genl_unregister_family(&miscore_nl_family);
+}
+
