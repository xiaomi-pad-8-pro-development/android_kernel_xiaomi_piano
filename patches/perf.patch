diff --git a/include/millet/millet.h b/include/millet/millet.h
new file mode 100644
index 0000000..08092d2
--- /dev/null
+++ b/include/millet/millet.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Millet ("smart frozen control subsystem") core interface, rebuilt for
+ * 6.12 from static analysis of the stock HyperOS OS4.0.5 millet_core.ko
+ * and its users. Offsets in the comments are the stock 6.6 ones; the
+ * hook prototypes match the kCFI type hashes in the stock binaries.
+ */
+#ifndef _MILLET_H
+#define _MILLET_H
+
+#include <linux/seq_file.h>
+#include <linux/spinlock.h>
+#include <linux/time64.h>
+#include <linux/types.h>
+
+/* Module types, from the stock name table at .rodata+0x9f8. */
+enum MILLET_TYPE {
+	O_TYPE = 0,	/* "NULL" */
+	SIG_TYPE,	/* "SIG" */
+	BINDER_TYPE,	/* "BINDER" */
+	BINDER_ST_TYPE,	/* "BINDER_STAT" */
+	MEM_TYPE,	/* "MEM" */
+	PKG_TYPE,	/* "PKG" */
+	HANDSHK_TYPE,	/* "HANDSHK" */
+	MILLET_TYPES_NUM,
+};
+
+/* msg_type values: the core accepts 1..3 when sending. */
+enum MILLET_MSG_TYPE {
+	MSG_NONE = 0,
+	LOOPBACK_MSG = 1,	/* handshake reply */
+	MSG_TO_USER = 2,
+	MSG_TO_KERN = 3,
+};
+
+#define NETLINK_MILLET		31
+#define MILLET_KERNEL_PORT	0x12341234UL
+#define MILLET_USER_PORT	0xabcddcbaUL
+#define MILLET_PRIV_UID_MAX	1000	/* recv_handler rejects uid > 1000 */
+
+/* Kernel -> user message, 0x90 bytes. */
+struct millet_data {
+	u32 owner;			/* 0x00 sending module type */
+	u32 monitor;			/* 0x04 module type it was routed to */
+	u32 msg_type;			/* 0x08 */
+	u32 reserved;			/* 0x0c */
+	u64 src_port;			/* 0x10 MILLET_KERNEL_PORT */
+	u64 dst_port;			/* 0x18 MILLET_USER_PORT */
+	u32 uid;			/* 0x20 */
+	u32 reserved2;			/* 0x24 */
+	struct timespec64 tm;		/* 0x28 set by the core */
+	union {				/* 0x38 module specific */
+		u64 sig;
+		struct {		/* SIG_TYPE, from millet_sig.ko */
+			u64 sig;		/* 0x38 */
+			u64 reserved[5];
+			u64 sig_mask;		/* 0x68 1 << sig */
+			struct task_struct *task;	/* 0x70 */
+			u32 pid;		/* 0x78 tgid */
+		} sig_info;
+		u8 data[0x58];
+	} mod;
+};
+static_assert(sizeof(struct millet_data) == 0x90);
+static_assert(offsetof(struct millet_data, mod.sig_info.pid) == 0x78);
+
+/* User -> kernel message, 0x50 bytes. */
+struct millet_userconf {
+	u32 owner;			/* 0x00 module type */
+	u32 msg_type;			/* 0x04 LOOPBACK_MSG or MSG_TO_KERN */
+	u64 src_port;			/* 0x08 MILLET_USER_PORT */
+	u64 dst_port;			/* 0x10 MILLET_KERNEL_PORT */
+	u8 data[0x38];			/* 0x18 module specific */
+};
+static_assert(sizeof(struct millet_userconf) == 0x50);
+
+struct millet_sock;
+typedef void (*recv_from_user)(void *data, unsigned int len);
+typedef int (*send_to_user)(struct task_struct *tsk, struct millet_data *data,
+			    struct millet_sock *sk);
+typedef void (*init_millet)(struct millet_sock *sk);
+
+/* One per module type, 0x78 bytes on 6.6. */
+struct millet_mod {
+	u32 id;				/* 0x00 */
+	u32 monitor;			/* 0x04 route messages to this type */
+	u32 port;			/* 0x08 netlink portid after handshake */
+	u32 handshake;			/* 0x0c */
+	recv_from_user recv_from;	/* 0x10 */
+	send_to_user send_to;		/* 0x18 */
+	init_millet init;		/* 0x20 */
+	spinlock_t lock;		/* 0x28 protects the counters */
+	u64 send_suc;			/* 0x30 */
+	u64 send_fail;			/* 0x38 */
+	u64 runtime;			/* 0x40 us */
+	char name[32];			/* 0x48 */
+	void *priv;			/* 0x68 module data (millet_sig) */
+	u32 enable;			/* 0x70 */
+};
+
+static_assert(sizeof(struct millet_mod) == 0x78);
+
+struct millet_sock {
+	struct sock *sock;
+	struct millet_mod mod[MILLET_TYPES_NUM];
+};
+
+extern unsigned int millet_debug;
+extern unsigned int frozen_uid_min;
+extern unsigned long binder_warn_ahead_space;
+extern bool millet_binder_switch;
+extern int freezebinder_enable;
+extern atomic_t core_black_pid_rec[10];
+extern atomic_t core_black_uid_rec[10];
+
+int register_millet_hook(int type, recv_from_user recv_from,
+			 send_to_user send_to, init_millet init);
+int unregister_millet_hook(int type);
+int init_millet_subsystem(int type);
+int millet_sendmsg(int type, struct task_struct *tsk, struct millet_data *data);
+int millet_sendto_user(struct task_struct *tsk, struct millet_data *data,
+		       struct millet_sock *sk);
+
+int core_uid_hash_add(uid_t uid);
+int core_uid_hash_del(uid_t uid);
+bool core_uid_hash_find(uid_t uid);
+void core_uid_hash_clear(void);
+void core_uid_hash_show(struct seq_file *m, const char *sep);
+int uid_rec_hash_add(uid_t uid);
+int uid_rec_hash_del(uid_t uid);
+bool uid_rec_hash_find(uid_t uid);
+bool uid_rec_hash_find_and_clear(uid_t uid);
+void uid_rec_hash_clear(void);
+void uid_rec_hash_show(struct seq_file *m, const char *sep);
+
+#endif
diff --git a/include/perf_actuator/perf_actuator.h b/include/perf_actuator/perf_actuator.h
new file mode 100644
index 0000000..9c20751
--- /dev/null
+++ b/include/perf_actuator/perf_actuator.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Interface of perf_actuator, rebuilt for 6.12 from the stock HyperOS
+ * OS4.0.5 module (vendor_boot perf_actuator.ko). The names and limits come
+ * from that binary's symbols and code; the header itself is new.
+ */
+#ifndef _PERF_ACTUATOR_H
+#define _PERF_ACTUATOR_H
+
+#include <linux/types.h>
+
+/* ioctl type byte checked by both devices (cmp w1, #0x78). */
+#define PERF_ACTUATOR_MAGIC	'x'
+/* Table sizes: register_perf_actuator rejects nr > 0x2a, register_xr_fbt nr > 0xb. */
+#define PERF_ACTUATOR_MAX_CMD	43
+#define XR_FBT_MAX_CMD		12
+
+/* Handlers get the raw user pointer from the ioctl. */
+typedef int (*perf_actuator_func)(void __user *uarg);
+
+int register_perf_actuator(unsigned int cmd, perf_actuator_func func);
+int unregister_perf_actuator(unsigned int cmd);
+int register_xr_fbt(unsigned int cmd, perf_actuator_func func);
+int unregister_xr_fbt(unsigned int cmd);
+
+#endif
diff --git a/include/plat_common/plat_common.h b/include/plat_common/plat_common.h
new file mode 100644
index 0000000..299403d
--- /dev/null
+++ b/include/plat_common/plat_common.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Interface of plat_common ("OS-CPU Platform Hook"), rebuilt for 6.12 from
+ * the stock HyperOS OS4.0.5 module vendor_boot plat_common.ko.
+ *
+ * Slot numbers: the g_plat_hook_table offset each exported wrapper loads,
+ * divided by the 16-byte entry size. Prototypes: recovered from the kCFI
+ * type hash the wrapper checks before its indirect call (xxhash64 of the
+ * Itanium-mangled function type), except the two marked UNRESOLVED, whose
+ * argument count and widths come from the sched-walt.ko call sites only.
+ */
+#ifndef _PLAT_COMMON_H
+#define _PLAT_COMMON_H
+
+#include <linux/types.h>
+
+struct task_struct;
+struct cpumask;
+struct rq;
+struct walt_related_thread_group;
+struct cgroup_subsys_state;
+
+enum plat_func_slot {
+	PLAT_SCHED_SET_GROUP_ID = 1,
+	PLAT_SCHED_GET_GROUP_ID = 2,
+	PLAT_TASK_UTIL = 3,
+	PLAT_CPU_HALTED = 4,
+	PLAT_CPU_HALT_MASK = 5,
+	PLAT_CAPACITY_ORIG_OF = 6,
+	PLAT_IS_MAX_POSSIBLE_CLUSTER_CPU = 7,
+	PLAT_FIND_IDLE_CPU_IN_FREQ_DOMAIN = 8,
+	PLAT_GET_GROUP_PREFER_CPUS = 9,
+	PLAT_GET_GROUP_PREFER_UTIL = 10,
+	PLAT_CORE_CTL_UPDATE = 11,
+	PLAT_LOOKUP_RELATED_THREAD_GROUP = 12,
+	PLAT_MI_GAME_FIND_ENERGY_HOOK = 13,
+	PLAT_UPDATE_PKG_LOAD = 14,
+	PLAT_MI_GAME_WALT_GET_INDICIES = 15,
+	PLAT_GAME_GET_RAVG_WINDOW = 16,
+	PLAT_MI_SET_NEXT_FREQ = 17,
+	PLAT_MI_GAME_TASK_FORK = 18,
+	PLAT_MI_GAME_SCHEDULER_TICK = 19,
+	PLAT_GAME_CHOOSE_CPU_FASTPATH = 20,
+	PLAT_FREE_MI_TASK_STRUCT = 21,
+	PLAT_GAME_CHOOSE_EXCLUSIVE_CPUS = 22,
+	PLAT_GAME_CHOOSE_CPU = 23,
+	PLAT_GAME_SKIP_CPUS = 24,
+	PLAT_GAME_SKIP_CPUS_RT = 25,
+	PLAT_GAME_SHOULD_SKIP_CPU_RT = 26,
+	PLAT_GAME_SHOULD_SKIP_MIGRATE = 27,
+	PLAT_GAME_CHECK_RT = 28,
+	PLAT_GAME_VIP_CHECK = 29,
+	PLAT_MIGT_ENABLE = 30,
+	PLAT_UPDATE_FRAME_LOAD = 35,
+	PLAT_FLT_ENABLE = 36,
+	PLAT_GET_WAKEUP_INFO = 37,
+	PLAT_MI_FORCE_UPDATE_FREQ = 38,
+	PLAT_ENABLE_GPSYNC = 39,
+	PLAT_MI_GAME_SCHEDULE = 40,
+	PLAT_FUNC_MAX = 41,	/* register_plat_func rejects nr > 0x28 */
+};
+
+int register_plat_func(unsigned int cmd, void *func);
+int unregister_plat_func(unsigned int cmd);
+
+int plat_sched_set_group_id(struct task_struct *p, unsigned int id);
+unsigned int plat_sched_get_group_id(struct task_struct *p);
+unsigned long plat_task_util(struct task_struct *p);
+bool plat_cpu_halted(int cpu);
+struct cpumask *plat_cpu_halt_mask(void);
+unsigned long plat_capacity_orig_of(int cpu);
+bool plat_is_max_possible_cluster_cpu(int cpu);
+int plat_find_idle_cpu_in_freq_domain(int cpu);
+void plat_get_group_prefer_cpus(struct task_struct *p, struct cpumask *mask);
+unsigned long plat_get_group_prefer_util(struct task_struct *p);
+void plat_core_ctl_update(void);
+struct walt_related_thread_group *plat_lookup_related_thread_group(unsigned int id);
+void plat_mi_game_find_energy_hook(struct task_struct *p, bool *out);
+void plat_update_pkg_load(struct task_struct *p, int a, int b, u64 c, u64 d);
+void plat_mi_game_walt_get_indicies(struct task_struct *p, int *order_index,
+				    int *end_index, int nr_clusters,
+				    bool *a, bool *b);
+void plat_game_get_ravg_window(unsigned int window);
+/* UNRESOLVED prototype: 7 register and 2 stack arguments at the call site. */
+void plat_mi_set_next_freq(void *a0, void *a1, unsigned int a2, u64 a3,
+			   u64 *a4, void *a5, void *a6, unsigned int a7,
+			   unsigned int a8);
+void plat_mi_game_task_fork(struct task_struct *p);
+void plat_mi_game_scheduler_tick(struct rq *rq);
+/* UNRESOLVED prototype: returns a CPU (negative for none) at the call site. */
+int plat_game_choose_cpu_fastpath(struct task_struct *p, struct cpumask *mask,
+				  bool *out);
+void plat_free_mi_task_struct(struct task_struct *p);
+int plat_game_choose_exclusive_cpus(struct task_struct *p);
+int plat_game_choose_cpu(struct task_struct *p);
+bool plat_game_skip_cpus(struct cpumask *mask);
+bool plat_game_skip_cpus_rt(struct task_struct *p, struct cpumask *mask);
+bool plat_game_should_skip_cpu_rt(struct task_struct *p, int cpu);
+bool plat_game_should_skip_migrate(struct task_struct *p, int cpu);
+bool plat_game_check_rt(struct task_struct *p);
+bool plat_game_vip_check(struct task_struct *p);
+int plat_migt_enable(void);
+void plat_update_frame_load(struct task_struct *p, struct rq *rq,
+			    unsigned int event, u64 wallclock, u64 delta,
+			    int flag);
+int plat_flt_enable(void);
+void plat_get_wakeup_info(struct task_struct *p);
+void plat_mi_force_update_freq(unsigned int arg);
+bool plat_enable_gpsync(void);
+void plat_mi_game_schedule(struct task_struct *prev, struct task_struct *next,
+			   struct rq *rq);
+
+void plat_init_sched_cgroup_id(struct cgroup_subsys_state *css);
+bool plat_is_relaxed_rt(struct task_struct *p);
+
+#endif
diff --git a/include/soc/qcom/minidump.h b/include/soc/qcom/minidump.h
new file mode 100644
index 0000000..4f6987e
--- /dev/null
+++ b/include/soc/qcom/minidump.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (c) 2017-2021, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022-2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ */
+
+#ifndef __MINIDUMP_H
+#define __MINIDUMP_H
+
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+enum minidump_entry_cmd {
+	MINIDUMP_ADD,
+	MINIDUMP_REMOVE,
+	MINIDUMP_UPDATE,
+	MINIDUMP_NO_CMD
+};
+
+#if IS_ENABLED(CONFIG_ARCH_QTI_VM)
+#define MAX_NAME_LENGTH		9
+#else
+#define MAX_NAME_LENGTH		12
+#endif
+
+/* md_region -  Minidump table entry
+ * @name:	Entry name, Minidump will dump binary with this name.
+ * @id:		Entry ID, used only for SDI dumps.
+ * @virt_addr:  Address of the entry.
+ * @phys_addr:	Physical address of the entry to dump.
+ * @size:	Number of byte to dump from @address location
+ *		it should be 4 byte aligned.
+ */
+struct md_region {
+	char	name[MAX_NAME_LENGTH + 1];
+	u32	id;
+	u64	virt_addr;
+	u64	phys_addr;
+	u64	size;
+};
+
+struct md_pending_region {
+	struct list_head	list;
+	struct md_region	entry;
+};
+
+
+struct md_rm_request {
+	struct md_region	entry;
+	struct work_struct	work;
+	enum minidump_entry_cmd	work_cmd;
+};
+
+/*
+ * Register an entry in Minidump table
+ * Returns:
+ *	region number: entry position in minidump table.
+ *	Negative error number on failures.
+ */
+#if IS_ENABLED(CONFIG_QCOM_MINIDUMP)
+extern int msm_minidump_add_region(const struct md_region *entry);
+extern int msm_minidump_remove_region(const struct md_region *entry);
+/*
+ * Update registered region address in Minidump table.
+ * It does not hold any locks, so strictly serialize the region updates.
+ * Returns:
+ *	Zero: on successfully update
+ *	Negetive error number on failures.
+ */
+extern int msm_minidump_update_region(int regno, const struct md_region *entry);
+extern bool msm_minidump_enabled(void);
