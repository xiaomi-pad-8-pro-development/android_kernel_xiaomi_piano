+	case 0x03: v = "ELPIDA"; break;
+	case 0x05: v = "NANYA"; break;
+	case 0x06: v = "SKHYNIX"; break;
+	case 0x0e: v = "INTEL"; break;
+	case 0x13: v = "CXMT"; break;
