new file mode 100644
index 0000000..d483f0a
--- /dev/null
+++ b/mi_wq_dynamic_priority/Kbuild
@@ -0,0 +1,5 @@
+# Out-of-tree / kp50 vendor/xiaomi/perf style.
+# export CONFIG_MI_WQ_DYNAMIC_PRIORITY := m
+# Optional: CONFIG_MI_WQ_DYNPRIO_XR_QI=y only if a 6.12 xr_qi.ko that
