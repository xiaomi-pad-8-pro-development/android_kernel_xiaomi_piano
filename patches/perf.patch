diff --git a/BUILD.bazel b/BUILD.bazel
new file mode 100644
index 0000000..b1ff15f
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,34 @@
+# Xiaomi kernel helpers for the Pad 8 Pro (piano) that ship as source in
+# the 6.6 tree, built out of tree against the Qualcomm 6.12 kernel.
+load("//build/kernel/kleaf:kernel.bzl", "kernel_module")
+
+package(default_visibility = ["//visibility:public"])
+
+kernel_module(
+    name = "sun_perf_perf",
+    srcs = glob(["**/*.c", "**/*.h", "**/*.S", "**/Makefile", "**/Kbuild"]),
+    outs = [
+        "boottime/boottime.ko",
+        "kshrink_slabd/kshrink_slabd.ko",
+        "lz4asm/lz4asm.ko",
+        "mi_rmap_efficiency/mi_rmap_efficiency.ko",
+        "mi_stack/mi_stack.ko",
+        "mi_trace/mi_trace.ko",
+        "mi_ubt/mi_ubt.ko",
+        "mi_thermal/mi_thermal_interface.ko",
+        "perf_actuator/perf_actuator.ko",
+        "plat_common/plat_common.ko",
+        "millet/millet_core.ko",
+        "millet/millet_hs.ko",
+        "millet/millet_sig.ko",
+        "millet/millet_oem_cgroup.ko",
+        "printk_enhance/printk_enhance.ko",
+    ],
+    kernel_build = "//soc-repo:sun_perf_base_kernel",
+    deps = [
+        "//soc-repo:all_headers",
+        "//soc-repo:sun_perf/drivers/soc/qcom/minidump",
+        "//soc-repo:sun_perf/drivers/soc/qcom/panel_event_notifier",
+        "//vendor/xiaomi/mca:sun_perf_mca",
+    ],
+)
diff --git a/Kbuild b/Kbuild
new file mode 100644
index 0000000..2198370
--- /dev/null
+++ b/Kbuild
@@ -0,0 +1,23 @@
+# Xiaomi kernel helpers for piano, from the 6.6 tree (seventeen). The
+# mca headers in include/ are copies; mi_thermal_interface calls into mca.
+PERF_ROOT := $(if $(filter /%,$(KBUILD_EXTMOD)),$(KBUILD_EXTMOD),$(abspath $(srctree)/$(KBUILD_EXTMOD)))
+
+export CONFIG_MI_BOOT_TIME := m
+export CONFIG_KSHRINK_SLABD := m
+export CONFIG_MI_RMAP_EFFICIENCY := m
+export CONFIG_MI_STACK := m
+export CONFIG_MI_TRACE := m
+export CONFIG_MI_UBT := m
+export CONFIG_PRINTK_ENHANCE := m
+export CONFIG_MI_THERMAL_INTERFACE := m
+export CONFIG_LZ4ASM := m
+export CONFIG_PERF_ACTUATOR := m
+export CONFIG_PLAT_COMMON := m
+export CONFIG_MILLET_CORE := m
+subdir-ccflags-y += -I$(PERF_ROOT)/include
+# minidump and the panel event notifier are soc-repo modules the base
+# kernel config does not know, so without these their headers compile to
+# stubs.
+subdir-ccflags-y += -DCONFIG_QCOM_MINIDUMP_MODULE=1 -DCONFIG_QCOM_PANEL_EVENT_NOTIFIER_MODULE=1
+
+obj-m += boottime/ kshrink_slabd/ mi_rmap_efficiency/ mi_stack/ mi_trace/ mi_ubt/ printk_enhance/ mi_thermal/ lz4asm/ perf_actuator/ plat_common/ millet/
diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..d294d06
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,8 @@
+# kleaf restores the Module.symvers of the soc-repo dependencies under
+# COMMON_OUT_DIR; hand them to modpost. mi_trace uses minidump, mi_thermal_interface uses mca.
+KBUILD_EXTRA_SYMBOLS += $(wildcard $(COMMON_OUT_DIR)/soc-repo/sun_perf/*/*/*_Module.symvers \
+	$(COMMON_OUT_DIR)/soc-repo/sun_perf/*/*/*/*_Module.symvers \
+	$(COMMON_OUT_DIR)/vendor/xiaomi/mca/*Module.symvers)
+
+modules modules_install clean:
+	$(MAKE) -C $(KERNEL_SRC) M=$(M) $(KBUILD_OPTIONS) KBUILD_EXTRA_SYMBOLS="$(KBUILD_EXTRA_SYMBOLS)" $@
