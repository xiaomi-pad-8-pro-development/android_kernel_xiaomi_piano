-
-	hw_version_reg = ioremap(TCSR_SOC_HW_VERSION, REG_SIZE);
-
-	if (!hw_version_reg) {
-		pr_err("reg remap failed for TCSR\n");
-		pce_dev->fifo_eco_unavailable = false;
-		return;
-	}
-	soc_hw_version = readl(hw_version_reg);
