# Xiaomi kernel helpers for the Pad 8 Pro (piano) that ship as source in
# the 6.6 tree, built out of tree against the Qualcomm 6.12 kernel.
load("//build/kernel/kleaf:kernel.bzl", "kernel_module")

package(default_visibility = ["//visibility:public"])

kernel_module(
    name = "sun_perf_perf",
    srcs = glob(["**/*.c", "**/*.h", "**/*.S", "**/Makefile", "**/Kbuild"]),
    outs = [
        "boottime/boottime.ko",
        "kshrink_slabd/kshrink_slabd.ko",
        "lz4asm/lz4asm.ko",
        "mi_rmap_efficiency/mi_rmap_efficiency.ko",
        "mi_stack/mi_stack.ko",
        "mi_trace/mi_trace.ko",
        "mi_ubt/mi_ubt.ko",
        "mi_thermal/mi_thermal_interface.ko",
        "perf_actuator/perf_actuator.ko",
        "plat_common/plat_common.ko",
        "rtg/rtg.ko",
        "millet/millet_core.ko",
        "millet/millet_hs.ko",
        "millet/millet_sig.ko",
        "millet/millet_oem_cgroup.ko",
        "rt_mod/rt_mod.ko",
        "printk_enhance/printk_enhance.ko",
        "mi_ubt/test/mi_ubt_test.ko",
        "mi_wq_dynamic_priority/mi_wq_dynamic_priority.ko",
        "millet_pkg/millet_pkg.ko",
        "binder_gki/binder_gki.ko",
        "millet_binder/millet_binder.ko",
        "bootinfo/bootinfo.ko",
        "dynamic_readahead/dynamic_readahead.ko",
        "debug_ext/debug_ext.ko",
        "xm_power/xm_power.ko",
        "mi_memory/mi_memory.ko",
        "mi_power/mi_power.ko",
        "bootmonitor/bootmonitor.ko",
        "dump_display/dump_display.ko",
        "swinfo/swinfo.ko",
        "hid_xiaomi/piano_hid_xiaomi.ko",
        "scene_swappiness/scene_swappiness.ko",
        "mi_wmark/mi_wmark.ko",
        "minet/minet.ko",
        "mi_mempool/mi_mempool.ko",
    ],
    kernel_build = "//soc-repo:sun_perf_base_kernel",
    deps = [
        "//soc-repo:all_headers",
        "//soc-repo:sun_perf/drivers/soc/qcom/minidump",
        "//soc-repo:sun_perf/drivers/soc/qcom/smem",
        "//soc-repo:sun_perf/drivers/firmware/qcom/qcom-scm",
        "//soc-repo:sun_perf/drivers/pinctrl/qcom/pinctrl-msm",
        "//soc-repo:sun_perf/drivers/soc/qcom/debug_symbol",
        "//soc-repo:sun_perf/drivers/dma-buf/heaps/qcom_dma_heaps",
        "//soc-repo:sun_perf/drivers/soc/qcom/panel_event_notifier",
        "//vendor/xiaomi/mca:sun_perf_mca",
    ],
)
