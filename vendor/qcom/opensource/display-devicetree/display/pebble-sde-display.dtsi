&dsi_ss_video_psr_vid_vhm {
	qcom,mdss-esync;
	qcom,mdss-esync-hsync-milli-pulse-width = <450>;
	qcom,mdss-esync-emsync-fps = <240>;
	qcom,mdss-esync-emsync-milli-pulse-width = <200>;

	qcom,qsync-enable;
	qcom,vrr-enable;
	qcom,video-psr-enable;
	qcom,dsi-qsync-avr-step-fps = <240>;
	qcom,mdss-dsi-qsync-min-refresh-rate = <60>;
};

&dsi_nt37802_amoled_video_psr_vhm {
	qcom,mdss-esync;
	qcom,mdss-esync-hsync-milli-pulse-width = <500>;
	qcom,mdss-esync-emsync-fps = <120>;
	qcom,mdss-esync-emsync-milli-pulse-width = <500>;

